# Dependencies
node_modules/
.pnpm-store/
.pnp.*

# Next.js & Web builds
.next/
out/
dist/
**/dist/

# Electron & Desktop release packaging (Avoid pushing 100MB+ binary installers to git)
release/
**/release/
win-unpacked/
linux-unpacked/
mac/
mac-arm64/
*.blockmap

# Large distribution binaries in public downloads (keep SHA256 checksums in git)
apps/web/public/downloads/*.dmg
apps/web/public/downloads/*.exe
apps/web/public/downloads/*.AppImage
apps/web/public/downloads/*.tar.gz
apps/web/public/downloads/*.zip
apps/web/public/downloads/*.blockmap
!apps/web/public/downloads/SHA256SUMS.txt

# Temporary test outputs and frame caches
test-results/
playwright-report/
test-output/
temp_render_frames/
temp_workspaces/

# Environment files
.env
.env*.local
.env.*.local

# Vercel
.vercel

# TypeScript & tooling cache
*.tsbuildinfo
next-env.d.ts
.eslintcache
.stylelintcache
.turbo/
.cache/
.vite/

# Logs & Debug
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/
*.swp
*~
