{
  "name": "html-motion-studio-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @html-motion-studio/web dev",
    "dev:desktop": "pnpm --filter @html-motion-studio/desktop dev",
    "build": "pnpm --filter @html-motion-studio/web build",
    "build:all": "pnpm -r run build",
    "start": "pnpm --filter @html-motion-studio/web start",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:render": "node scripts/run-render-tests.mjs",
    "lint": "pnpm --filter @html-motion-studio/web lint"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^20.17.0",
    "typescript": "^5.6.3"
  }
}
